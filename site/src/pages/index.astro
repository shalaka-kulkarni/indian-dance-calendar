---
import '../styles/tokens.css';
import HeroArt from '../components/HeroArt.astro';
import Motif from '../components/Motif.astro';
import Subscribe from '../components/Subscribe.astro';
import Disclaimer from '../components/Disclaimer.astro';
import data from '../data/events.json';
import { FORM_LABELS, STYLE_LABELS, TRADITION_LABELS, ART_FORM_LABELS, REGION_LABELS, PRESENTER_LABELS, KIND_LABELS } from '../labels.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const upcoming = data.events ?? [];
const past = data.pastEvents ?? [];
const filters = data.filters ?? { artForms: [], traditions: [], regions: [], presenterTypes: [], kinds: [], free: 0 };
const generatedAt = new Date(data.generatedAt);

// A mixed bill takes its colour from the most "classical" tradition present.
const TRADITION_PRIORITY = ['classical', 'semi_classical_fusion', 'contemporary', 'folk', 'popular_film'];
const primaryTradition = (e) =>
  TRADITION_PRIORITY.find((t) => (e.traditions ?? []).includes(t)) ?? 'classical';
const styleLabel = (v) => STYLE_LABELS[v] ?? FORM_LABELS[v] ?? v;

const NY = 'America/New_York';
const fmtDay = (iso, opts) =>
  new Date(iso).toLocaleDateString('en-US', { timeZone: NY, ...opts });
const fmtTime = (iso) => {
  const t = new Date(iso).toLocaleTimeString('en-US', {
    hour: 'numeric', minute: '2-digit', timeZone: NY,
  });
  return t === '12:00 AM' ? '' : t.toLowerCase().replace(' ', ''); // midnight = time unknown
};
const monthKey = (iso) => fmtDay(iso, { year: 'numeric', month: '2-digit' });
const monthName = (iso) => fmtDay(iso, { month: 'long', year: 'numeric' });

function groupByMonth(list) {
  const out = [];
  for (const e of list) {
    const k = monthKey(e.start);
    let g = out.find((x) => x.key === k);
    if (!g) { g = { key: k, label: monthName(e.start), events: [] }; out.push(g); }
    g.events.push(e);
  }
  return out;
}
const upcomingMonths = groupByMonth(upcoming);
const pastMonths = groupByMonth(past);

// Every date is spelled out. "+1 more" told the reader nothing they could act on.
const dayLabel = (iso) => fmtDay(iso, { weekday: 'short', month: 'short', day: 'numeric' });
function datesLine(e) {
  const t = fmtTime(e.start);
  const sameDay = (a, b) => a.slice(0, 10) === b.slice(0, 10);
  if (e.end && !sameDay(e.end, e.start)) {
    return `${dayLabel(e.start)} – ${dayLabel(e.end)}${t ? ` · from ${t}` : ''}`;
  }
  const all = [e.start, ...(e.additionalDates ?? [])];
  if (all.length > 1) {
    return all.map((d) => `${dayLabel(d)}${fmtTime(d) ? ` ${fmtTime(d)}` : ''}`).join('  ·  ');
  }
  return `${dayLabel(e.start)}${t ? ` · ${t}` : ''}`;
}

// webcal: makes Apple Calendar / Outlook treat this as a live subscription that
// keeps updating, rather than a one-off .ics download.
const feedHttps = new URL(`${base}/calendar.ics`, Astro.site ?? 'https://shalaka-kulkarni.github.io').href;
const feedWebcal = feedHttps.replace(/^https?:/, 'webcal:');

const TITLE = 'Rasa — every Indian dance and music event across the New York City metro area, in one calendar.';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rasa — Indian performing arts in New York</title>
    <meta name="description" content={TITLE} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <Disclaimer variant="short" />

    <header class="masthead">
      <HeroArt side="left" />
      <HeroArt side="right" />
      <div class="masthead-inner wrap">
        <h1>
          <span class="h1-a">Rasa</span>
          <span class="h1-b">Indian performing arts across the New York City metro area</span>
        </h1>
        <p class="tagline">
          Dance and music — classical, folk, fusion and film — from the big
          houses to the community halls, in one calendar.
        </p>
        <Subscribe variant="hero" />
        <p class="masthead-cta">
          <a class="btn-poster btn-sub" href={feedWebcal}>＋ Add to your calendar app</a>
          <a class="btn-poster" href={`${base}/about`}>About</a>
        </p>
      </div>
    </header>

    <nav class="tabs" role="tablist" aria-label="Upcoming or past events">
      <button class="tab" id="tab-upcoming" role="tab" aria-selected="true"
              aria-controls="panel-upcoming">
        <span>Upcoming</span><span class="n">{upcoming.length}</span>
      </button>
      <button class="tab" id="tab-past" role="tab" aria-selected="false"
              aria-controls="panel-past">
        <span>Past events</span><span class="n">{past.length}</span>
      </button>
    </nav>

    <div class="rail">
      <div class="wrap rail-inner">
        <div class="fgroup fgroup-primary" role="group" aria-label="Dance or music">
          <span class="flabel">Show</span>
          <div class="chips">
            {filters.artForms.map((a) => (
              <button type="button" role="checkbox"
                      aria-checked={a.value === 'dance' ? 'true' : 'false'}
                      class:list={['chip', 'chip-art', a.value === 'dance' && 'on']}
                      data-filter="art" data-value={a.value}
                      aria-disabled={a.count === 0 ? 'true' : 'false'}>
                {ART_FORM_LABELS[a.value]}<span class="n">{a.count}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="fgroup" role="group" aria-label="Tradition">
          <span class="flabel">Style</span>
          <div class="chips">
            {filters.traditions.map((t) => (
              <button class="chip" type="button" role="checkbox" aria-checked="false"
                      data-filter="tradition" data-value={t.value}
                      style={`--chip-form: var(--trad-${t.value}); --chip-form-ink: var(--trad-${t.value}-ink);`}
                      aria-disabled={t.count === 0 ? 'true' : 'false'}>
                {TRADITION_LABELS[t.value]}<span class="n">{t.count}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="fgroup" role="group" aria-label="Where">
          <span class="flabel">Where</span>
          <div class="chips">
            {filters.regions.map((r) => (
              <button class="chip" type="button" role="checkbox" aria-checked="false"
                      data-filter="region" data-value={r.value}
                      aria-disabled={r.count === 0 ? 'true' : 'false'}>
                {REGION_LABELS[r.value] ?? r.value}<span class="n">{r.count}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="fgroup" role="group" aria-label="More filters">
          <span class="flabel">More</span>
          <div class="chips">
            <button class="chip" type="button" role="checkbox" aria-checked="false"
                    data-filter="free" data-value="true"
                    aria-disabled={filters.free === 0 ? 'true' : 'false'}>
              Free<span class="n">{filters.free}</span>
            </button>
            {filters.presenterTypes.map((p) => (
              <button class="chip" type="button" role="checkbox" aria-checked="false"
                      data-filter="presenter" data-value={p.value}
                      aria-disabled={p.count === 0 ? 'true' : 'false'}>
                {PRESENTER_LABELS[p.value] ?? p.value}<span class="n">{p.count}</span>
              </button>
            ))}
            {filters.kinds.filter((k) => k.value !== 'performance').map((k) => (
              <button class="chip" type="button" role="checkbox" aria-checked="false"
                      data-filter="kind" data-value={k.value}
                      aria-disabled={k.count === 0 ? 'true' : 'false'}>
                {KIND_LABELS[k.value] ?? k.value}<span class="n">{k.count}</span>
              </button>
            ))}
            <button class="chip chip-clear" type="button" id="clear-filters" hidden>Clear ✕</button>
          </div>
        </div>
        <p class="count" role="status" aria-live="polite">
          <span id="shown-count">{upcoming.length}</span> shown
        </p>
      </div>
    </div>

    <main>
      {[
        { id: 'panel-upcoming', labelledby: 'tab-upcoming', months: upcomingMonths, isPast: false,
          empty: `No upcoming events published yet — the next sweep of ${data.sourceCount} venue calendars and listings will fill this page.` },
        { id: 'panel-past', labelledby: 'tab-past', months: pastMonths, isPast: true,
          empty: 'No past events in the archive yet. Events move here automatically once their date passes, and stay for six months.' },
      ].map((panel) => (
        <section id={panel.id} role="tabpanel" aria-labelledby={panel.labelledby}
                 class={panel.isPast ? 'panel panel-past' : 'panel'}>
          {panel.months.length === 0 && <p class="empty wrap">{panel.empty}</p>}
          {panel.months.map((m, mi) => (
            <section class="month">
              <h2 class={`month-band band-${mi % 4}`}>
                <span class="wrap band-inner">
                  <span>{m.label}</span><span class="band-n">{m.events.length}</span>
                </span>
              </h2>
              <div class="wrap">
                <div class="event-grid">
                  {m.events.map((e) => (
                    <article class={panel.isPast ? 'event is-past' : 'event'}
                             data-region={e.region}
                             data-free={String(e.isFree)}
                             data-presenter={e.presenterType}
                             data-kind={e.kind}
                             data-art={e.artForm}
                             data-traditions={(e.traditions ?? []).join(',')}
                             style={`--form: var(--trad-${primaryTradition(e)}); --form-ink: var(--trad-${primaryTradition(e)}-ink);`}>
                      <div class="date-col">
                        <span class="date-m">{fmtDay(e.start, { month: 'short' })}</span>
                        <span class="date-d">{fmtDay(e.start, { day: 'numeric' })}</span>
                        <span class="date-w">{fmtDay(e.start, { weekday: 'short' })}</span>
                        <Motif form={e.artForm === 'music' ? 'music' : primaryTradition(e)} class="date-motif" />
                      </div>

                      <div class="event-body">
                        <h3>{e.title}{panel.isPast && <span class="stamp">Past</span>}</h3>
                        <p class="when">{datesLine(e)}</p>
                        <p class="meta">
                          <span class="venue">{e.venue}</span>
                          {REGION_LABELS[e.region] && <span class="dot">·</span>}
                          {REGION_LABELS[e.region] && <span>{REGION_LABELS[e.region]}</span>}
                        </p>
                        <p class="chips-row">
                          {(e.traditions ?? []).map((t) => (
                            <span class="tag" style={`--form-c: var(--trad-${t}); --form-c-ink: var(--trad-${t}-ink);`}>
                              {TRADITION_LABELS[t] ?? t}
                            </span>
                          ))}
                          {(e.styles ?? [])
                            .filter((v) => !(e.traditions ?? []).some(
                              (t) => TRADITION_LABELS[t]?.toLowerCase() === styleLabel(v).toLowerCase()
                            ))
                            .map((v) => (
                              <span class="tag tag-outline">{styleLabel(v)}</span>
                            ))}
                          {KIND_LABELS[e.kind] && <span class="tag tag-outline">{KIND_LABELS[e.kind]}</span>}
                          {PRESENTER_LABELS[e.presenterType] && (
                            <span class="tag tag-outline">{PRESENTER_LABELS[e.presenterType]}</span>
                          )}
                        </p>
                        {e.description && <p class="desc">{e.description}</p>}
                        {e.editorNote && <p class="note">{e.editorNote}</p>}
                      </div>

                      <div class="action-col">
                        {e.isFree && <span class="price-free">Free</span>}
                        {!e.isFree && e.price && <span class="price">{e.price}</span>}
                        {!e.isFree && !e.price && !panel.isPast && <span class="price-tba">Price TBA</span>}
                        {!panel.isPast && e.ticketUrl && e.ticketUrl !== e.infoUrl && (
                          <a class="btn-poster btn-ticket" href={e.ticketUrl} target="_blank" rel="noopener">Book tickets</a>
                        )}
                        {!panel.isPast && (!e.ticketUrl || e.ticketUrl === e.infoUrl) && (
                          <a class="btn-poster btn-ticket" href={e.infoUrl} target="_blank" rel="noopener">Info &amp; tickets</a>
                        )}
                        {(panel.isPast || (e.ticketUrl && e.ticketUrl !== e.infoUrl)) && (
                          <a class="btn-poster btn-info" href={e.infoUrl} target="_blank" rel="noopener">Info</a>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            </section>
          ))}
        </section>
      ))}
    </main>

    <footer>
      <div class="wrap">
        <Subscribe variant="footer" />
        <Disclaimer variant="long" />
        <p>
          Updated automatically. Last sweep {generatedAt.toLocaleDateString('en-US', {
            month: 'short', day: 'numeric', year: 'numeric', timeZone: NY,
          })} — watching {data.sourceCount} venue calendars and listings, plus a weekly
          broad search. The venue's own page is always the authority on dates, prices and tickets.
        </p>
        <p>
          <a href={`${base}/about`}>About &amp; how to subscribe</a> ·
          <a href={`${base}/calendar.ics`}>Download .ics</a>
        </p>
      </div>
    </footer>

    <script>
      // Dance is on by default; music is opt-in. An event tagged "both" answers
      // to either, so community nights never vanish when you pick one.
      const active = {
        art: new Set(['dance']),
        tradition: new Set(), region: new Set(), free: new Set(),
        presenter: new Set(), kind: new Set(),
      };
      const chips = [...document.querySelectorAll('.chip[data-filter]')];
      const clearBtn = document.getElementById('clear-filters');
      const countEl = document.getElementById('shown-count');
      const panels = {
        'tab-upcoming': document.getElementById('panel-upcoming'),
        'tab-past': document.getElementById('panel-past'),
      };
      let currentTab = 'tab-upcoming';

      const cardData = (card) => ({
        art: card.dataset.art === 'both' ? ['dance', 'music'] : [card.dataset.art],
        traditions: (card.dataset.traditions || '').split(',').filter(Boolean),
        region: card.dataset.region,
        free: card.dataset.free === 'true',
        presenter: card.dataset.presenter,
        kind: card.dataset.kind,
      });

      function matches(d, sel) {
        if (sel.art.size && !d.art.some((a) => sel.art.has(a))) return false;
        if (sel.tradition.size && !d.traditions.some((t) => sel.tradition.has(t))) return false;
        if (sel.region.size && !sel.region.has(d.region)) return false;
        if (sel.free.size && !d.free) return false;
        if (sel.presenter.size && !sel.presenter.has(d.presenter)) return false;
        if (sel.kind.size && !sel.kind.has(d.kind)) return false;
        return true;
      }

      function apply() {
        const panel = panels[currentTab];
        const cards = [...panel.querySelectorAll('article.event')];
        const data = cards.map((c) => ({ card: c, d: cardData(c) }));

        let shown = 0;
        for (const { card, d } of data) {
          const ok = matches(d, active);
          card.hidden = !ok;
          if (ok) shown += 1;
        }
        for (const month of panel.querySelectorAll('section.month')) {
          month.hidden = ![...month.querySelectorAll('article.event')].some((c) => !c.hidden);
        }
        if (countEl) countEl.textContent = String(shown);

        // A chip is disabled when adding it to the current selection yields nothing.
        for (const chip of chips) {
          const { filter, value } = chip.dataset;
          if (!filter) continue;
          if (filter === 'art') continue;  // keeps its build-time total
          const isOn = active[filter].has(value);
          let n;
          if (isOn) {
            n = data.filter(({ d }) => matches(d, active)).length;
          } else {
            const probe = {};
            for (const k of Object.keys(active)) probe[k] = new Set(active[k]);
            probe[filter].add(value);
            n = data.filter(({ d }) => matches(d, probe)).length;
          }
          const numEl = chip.querySelector('.n');
          if (numEl) numEl.textContent = String(n);
          chip.setAttribute('aria-disabled', n === 0 && !isOn ? 'true' : 'false');
        }

        const nonDefault =
          active.tradition.size || active.region.size || active.free.size ||
          active.presenter.size || active.kind.size ||
          !(active.art.size === 1 && active.art.has('dance'));
        if (clearBtn) clearBtn.hidden = !nonDefault;
      }

      for (const chip of chips) {
        chip.addEventListener('click', () => {
          if (chip.getAttribute('aria-disabled') === 'true') return;
          const { filter, value } = chip.dataset;
          const set = active[filter];
          if (set.has(value)) {
            // Turning the last art-form chip off would show nothing at all.
            if (filter === 'art' && set.size === 1) return;
            set.delete(value); chip.classList.remove('on'); chip.setAttribute('aria-checked', 'false');
          } else {
            set.add(value); chip.classList.add('on'); chip.setAttribute('aria-checked', 'true');
          }
          apply();
        });
      }
      clearBtn?.addEventListener('click', () => {
        for (const s of Object.values(active)) s.clear();
        active.art.add('dance');
        for (const c of chips) {
          const isDance = c.dataset.filter === 'art' && c.dataset.value === 'dance';
          c.classList.toggle('on', isDance);
          c.setAttribute('aria-checked', String(isDance));
        }
        apply();
      });

      // Tabs: both panels are in the HTML, so without JS the archive is still reachable.
      const tabs = [...document.querySelectorAll('.tab')];
      function selectTab(id) {
        currentTab = id;
        for (const t of tabs) {
          const on = t.id === id;
          t.setAttribute('aria-selected', String(on));
          panels[t.id].hidden = !on;
        }
        apply();
      }
      for (const t of tabs) {
        t.addEventListener('click', () => selectTab(t.id));
        t.addEventListener('keydown', (ev) => {
          if (ev.key !== 'ArrowRight' && ev.key !== 'ArrowLeft') return;
          const next = tabs[(tabs.indexOf(t) + 1) % tabs.length];
          next.focus(); selectTab(next.id);
        });
      }
      selectTab('tab-upcoming');
    </script>

    <style is:global>
      /* ---------- masthead ---------- */
      /* One dark ground, art on top, one bright rule. The colour lives in the
         artwork and the cards, not in three competing background fields. */
      .masthead {
        position: relative; isolation: isolate; overflow: hidden;
        border-bottom: 6px solid var(--turmeric);
        min-height: clamp(300px, 42vh, 440px);
        display: grid; align-content: end;
        padding: clamp(2rem, 6vw, 3.5rem) 0 clamp(1.5rem, 3vw, 2.25rem);
        background: #15110f;
      }

            .hero-art { position: absolute; bottom: 0; height: 100%; width: auto; z-index: 0; }
      /* Dissolve the ornament at its inner edge so it reads as engraving on the
         ground, not as a pasted-on panel with a rectangular border. */
      .hero-art-left {
        left: 0;
        -webkit-mask-image: linear-gradient(100deg, #000 0 35%, transparent 92%);
                mask-image: linear-gradient(100deg, #000 0 35%, transparent 92%);
      }
      .hero-art-right {
        right: 0;
        -webkit-mask-image: linear-gradient(260deg, #000 0 40%, transparent 95%);
                mask-image: linear-gradient(260deg, #000 0 40%, transparent 95%);
      }
      /* Below this width the art would crowd the words, so it steps aside. */
      @media (max-width: 1080px) { .hero-art-left { display: none; } }
      @media (max-width: 780px) { .hero-art-right { opacity: .35; } }
            .masthead-inner { position: relative; z-index: 1; }
      @media (min-width: 1081px) { .masthead-inner { padding-left: 15rem; padding-right: 17rem; } }
      @media (min-width: 781px) and (max-width: 1080px) { .masthead-inner { padding-right: 15rem; } }
      .masthead h1 { margin: 0 0 .8rem; }
      .h1-a {
        display: block;
        font: 900 var(--t-hero)/0.88 var(--font-display);
        text-transform: uppercase; letter-spacing: .04em;
        color: #fff9ec;
        text-shadow: 5px 5px 0 #c4162a;
      }
      .h1-b {
        display: block; margin-top: .8rem; color: #f5c400;
        font: 700 clamp(.82rem, 1.7vw, 1rem)/1.35 var(--font-condensed);
        text-transform: uppercase; letter-spacing: .12em;
      }
      .tagline {
        color: #efe6d6; display: block; max-width: 46ch;
        font: 400 clamp(.95rem, 1.6vw, 1.05rem)/1.5 var(--font-ui);
        margin: .7rem 0 1.2rem;
      }
      .masthead-cta { display: flex; gap: .6rem; flex-wrap: wrap; margin: 0; }
      .btn-sub { background: var(--turmeric); color: var(--turmeric-ink); }

      /* ---------- tabs ---------- */
      .tabs { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 6px solid var(--rule); }
      .tab {
        font: 900 clamp(1rem, 3vw, 1.7rem)/1 var(--font-display);
        text-transform: uppercase; letter-spacing: .02em;
        padding: 1rem 1.1rem; border: 0; border-right: 3px solid var(--rule);
        background: var(--surface-sunk); color: var(--ink-muted); cursor: pointer;
        display: flex; justify-content: space-between; align-items: baseline; gap: .6rem;
      }
      .tab:last-child { border-right: 0; }
      .tab .n { font: 700 .95rem/1 var(--font-condensed); font-variant-numeric: tabular-nums; }
      .tab[aria-selected="true"] { background: var(--turmeric); color: var(--turmeric-ink); }
      #tab-past[aria-selected="true"] { background: var(--rail-bg); color: var(--rail-ink); }

      /* ---------- filter rail ---------- */
      .rail {
        position: sticky; top: 0; z-index: 20;
        background: var(--rail-bg); border-bottom: 4px solid var(--turmeric);
      }
      .rail-inner { padding-top: .8rem; padding-bottom: .8rem; }
      .fgroup { display: flex; align-items: baseline; gap: .6rem; margin-bottom: .5rem; }
      .flabel {
        font: 700 .68rem/1 var(--font-condensed); letter-spacing: .14em;
        text-transform: uppercase; color: var(--turmeric); min-width: 3.4rem; flex: none;
      }
      .chips { display: flex; gap: .35rem; flex-wrap: wrap; }
      .chip {
        font: 700 .76rem/1 var(--font-condensed);
        text-transform: uppercase; letter-spacing: .07em;
        padding: .4rem .65rem; border: 2px solid var(--rail-ink); border-radius: 0;
        background: transparent; color: var(--rail-ink); cursor: pointer;
        display: inline-flex; align-items: center; gap: .4rem;
      }
      .chip .n { font-variant-numeric: tabular-nums; color: var(--turmeric); }
      .chip.on {
        background: var(--chip-form, var(--turmeric));
        color: var(--chip-form-ink, var(--turmeric-ink));
        border-color: var(--chip-form, var(--turmeric));
        box-shadow: 3px 3px 0 0 var(--rail-ink);
      }
      .chip.on .n { color: inherit; }
      .chip.on::after { content: "✕"; font-size: .85em; }
      .chip[aria-disabled="true"] {
        color: var(--ink-disabled); border-color: var(--ink-disabled);
        border-style: dashed; cursor: not-allowed; box-shadow: none;
        text-decoration: line-through; text-decoration-thickness: 2px;
      }
      .chip[aria-disabled="true"] .n { color: var(--ink-disabled); }
      .chip-clear { background: var(--kumkum); color: var(--kumkum-ink); border-color: var(--kumkum); }
      /* The art-form toggle is the top-level control, so it is bigger and louder. */
      .fgroup-primary { padding-bottom: .2rem; border-bottom: 2px solid var(--rule-soft); margin-bottom: .55rem; }
      .chip-art { font-size: .88rem; padding: .5rem .95rem; letter-spacing: .1em; }
      .chip-art.on { background: var(--turmeric); color: var(--turmeric-ink); border-color: var(--turmeric); }
      /* display:inline-flex would otherwise beat the hidden attribute */
      .chip[hidden] { display: none; }

      /* On phones the rail is sticky, so wrapping every chip would eat the
         screen. Each group scrolls sideways instead and stays one row. */
      @media (max-width: 720px) {
        .chips {
          flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none;
          scroll-snap-type: x proximity; padding-bottom: .15rem;
        }
        .chips::-webkit-scrollbar { display: none; }
        .chip { flex: none; scroll-snap-align: start; }
        .fgroup { align-items: center; gap: .5rem; margin-bottom: .35rem; }
        .flabel { min-width: 2.9rem; }
      }
      .count {
        margin: .3rem 0 0; color: var(--rail-ink);
        font: 700 .74rem/1 var(--font-condensed); letter-spacing: .1em; text-transform: uppercase;
      }

      /* ---------- month bands ---------- */
      .month-band {
        margin: 0; border-bottom: 3px solid var(--rule);
        font: 900 clamp(1.1rem, 2.4vw, 1.6rem)/1 var(--font-display);
        text-transform: uppercase; letter-spacing: .02em;
        padding: .45rem 0 .35rem; background: var(--bg); color: var(--ink);
        position: sticky; top: var(--rail-h, 0); z-index: 5;
      }
      .month-band .band-inner { border-left: 10px solid var(--band-c, var(--turmeric)); padding-left: .7rem; }
      .band-inner { display: flex; justify-content: space-between; align-items: baseline; }
      .band-n { font: 700 .9rem/1 var(--font-condensed); font-variant-numeric: tabular-nums; }
      .band-0 { --band-c: var(--turmeric); }
      .band-1 { --band-c: var(--peacock); }
      .band-2 { --band-c: var(--kumkum); }
      .band-3 { --band-c: var(--indigo); }
      .panel-past .month-band { --band-c: var(--ink-muted); }
      .panel-past { background: var(--bg-alt); }

      /* ---------- event rows ----------
         A list, not a grid: single-event months no longer leave two empty
         cells, and the horizontal space goes to the description instead. */
      main { padding-bottom: 3rem; }
      .month { margin-bottom: 1.6rem; }
      .event-grid { display: flex; flex-direction: column; gap: .9rem; padding-top: 1rem; }

      .event {
        position: relative;
        display: grid;
        grid-template-columns: 5.5rem minmax(0, 1fr) minmax(9.5rem, auto);
        gap: 1.1rem;
        background: var(--surface);
        border: 3px solid var(--rule);
        border-left: 10px solid var(--form);
        padding: 1rem 1.1rem;
        box-shadow: 4px 4px 0 0 var(--offset);
        /* No hover lift: nothing happens when you click a row, so it must not
           behave like a button. Only the real links react. */
      }
      @media (max-width: 760px) {
        .event { grid-template-columns: 4.2rem minmax(0, 1fr); }
        .action-col { grid-column: 1 / -1; flex-direction: row; align-items: center; flex-wrap: wrap; }
      }

      .date-col {
        text-align: center; border-right: 2px solid var(--rule-soft); padding-right: .6rem;
        display: flex; flex-direction: column; align-items: center; gap: .05rem;
      }
      .date-m {
        font: 700 .68rem/1 var(--font-condensed); letter-spacing: .14em;
        text-transform: uppercase; color: var(--form);
      }
      .date-d { font: 900 var(--t-day)/0.9 var(--font-display); color: var(--ink); }
      .date-w {
        font: 700 .66rem/1 var(--font-condensed); letter-spacing: .1em;
        text-transform: uppercase; color: var(--ink-muted);
      }
      .date-motif { width: 2rem; height: 2rem; margin-top: .5rem; color: var(--form); opacity: .9; }

      .event-body h3 {
        margin: 0 0 .3rem; font: 800 var(--t-title)/1.25 var(--font-ui);
        text-wrap: balance;
      }
      .when {
        margin: 0 0 .2rem; font: 700 .9rem/1.4 var(--font-ui); color: var(--ink);
      }
      .meta { margin: 0 0 .5rem; font: 400 .9rem/1.4 var(--font-ui); color: var(--ink-muted); }
      .meta .venue { font-weight: 600; color: var(--ink); }
      .meta .dot { margin: 0 .4rem; color: var(--ink-muted); }
      .chips-row { display: flex; gap: .3rem; flex-wrap: wrap; margin: 0 0 .5rem; }
      .tag {
        background: var(--form-c); color: var(--form-c-ink);
        border: 2px solid var(--rule); padding: .14rem .42rem;
        font: 700 .68rem/1 var(--font-condensed);
        letter-spacing: .07em; text-transform: uppercase;
      }
      .tag-outline { background: transparent; color: var(--ink-muted); border-color: var(--rule-soft); }
      /* Full description — a clamped card with no way to expand is a dead end. */
      .desc { margin: 0; font-size: .93rem; line-height: 1.5; max-width: 70ch; }
      .note { margin: .4rem 0 0; font-size: .9rem; font-style: italic; color: var(--ink-muted); }

      .action-col {
        display: flex; flex-direction: column; align-items: stretch; gap: .5rem;
        border-left: 2px solid var(--rule-soft); padding-left: 1rem;
      }
      @media (max-width: 760px) { .action-col { border-left: 0; padding-left: 0; padding-top: .6rem; } }
      .price { font: 900 1.3rem/1 var(--font-display); text-align: center; }
      .price-free {
        background: var(--turmeric); color: var(--turmeric-ink);
        border: 2px solid var(--rule); padding: .22rem .5rem; text-align: center;
        font: 700 .78rem/1 var(--font-condensed); letter-spacing: .1em; text-transform: uppercase;
      }
      .price-tba {
        color: var(--ink-muted); border: 2px dashed var(--rule-soft); padding: .2rem .45rem;
        text-align: center;
        font: 700 .7rem/1 var(--font-condensed); letter-spacing: .08em; text-transform: uppercase;
      }

      /* ---------- archive rows ---------- */
      .event.is-past { box-shadow: none; background: var(--surface); }
      .event.is-past .date-d, .event.is-past .date-m { color: var(--ink-muted); }
      .stamp {
        display: inline-block; margin-left: .5rem; vertical-align: middle;
        background: var(--rail-bg); color: var(--rail-ink);
        border: 2px solid var(--rule); padding: .1rem .4rem;
        font: 900 .62rem/1.3 var(--font-display); letter-spacing: .18em; text-transform: uppercase;
      }

      /* ---------- email signup ---------- */
      .subscribe { margin: 0 0 1rem; max-width: 30rem; }
      .sub-label {
        display: block; margin-bottom: .4rem;
        font: 700 .74rem/1.3 var(--font-condensed);
        letter-spacing: .12em; text-transform: uppercase;
      }
      .subscribe-hero .sub-label { color: #f5c400; }
      .sub-row { display: flex; gap: .5rem; flex-wrap: wrap; }
      .sub-row input {
        flex: 1 1 14rem; min-width: 0;
        border: 3px solid var(--rule); border-radius: 0; padding: .6rem .7rem;
        font: 400 .95rem/1.2 var(--font-ui);
        background: var(--surface); color: var(--ink);
      }
      .subscribe-hero .sub-row input { border-color: #fff9ec; background: #fff9ec; color: #15110f; }
      .sub-fine { margin: .4rem 0 0; font-size: .78rem; color: var(--ink-muted); }
      .subscribe-hero .sub-fine { color: #cdbfa8; }
      .subscribe-footer { margin-bottom: 1.4rem; }

      .empty {
        border: 3px dashed var(--rule-soft); padding: 2rem;
        margin: 2rem auto; color: var(--ink-muted); max-width: 46rem;
      }
      footer {
        border-top: 6px solid var(--rule); background: var(--surface-sunk);
        padding: 1.5rem 0 3rem; color: var(--ink-muted); font-size: .86rem;
      }
      .disclaimer-strip {
        margin: 0; background: var(--rail-bg); color: var(--rail-ink);
        text-align: center; padding: .45rem 1rem;
        font: 700 .7rem/1.4 var(--font-condensed);
        letter-spacing: .1em; text-transform: uppercase;
        border-bottom: 2px solid var(--turmeric);
      }
      .disclaimer-long { margin: 1.6rem 0 0; max-width: 60ch; }
      .disclaimer-long h2 {
        font: 900 .95rem/1 var(--font-display); text-transform: uppercase;
        letter-spacing: .1em; color: var(--ink); margin: 0 0 .6rem;
      }
      .disclaimer-long p { margin: 0 0 .7rem; font-size: .82rem; line-height: 1.55; }
      footer a { color: var(--link); }

      @media (prefers-reduced-motion: reduce) {
        .event, .event:hover { transition: none; transform: none; }
      }
    </style>
  </body>
</html>
