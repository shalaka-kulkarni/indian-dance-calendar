---
// Masthead artwork: fine engraved linework rather than flat cut-out shapes —
// a jaali lattice on one side, a mandala and ogee arch on the other. Drawn in
// thin gold strokes so it reads as ornament behind the title, not clipart.
const { side = 'left' } = Astro.props;
---
{side === 'left' && (
  <svg class="hero-art hero-art-left" viewBox="0 0 240 420" aria-hidden="true"
       focusable="false" xmlns="http://www.w3.org/2000/svg"
       fill="none" stroke="#c9a227" stroke-width="1.1">
    <defs>
      {/* jaali: interlocking pointed arches, the screen you see cut into stone */}
      <pattern id="jaali" x="0" y="0" width="60" height="72" patternUnits="userSpaceOnUse">
        <path d="M30 0C30 20 46 30 60 36 46 42 30 52 30 72 30 52 14 42 0 36 14 30 30 20 30 0Z"/>
        <path d="M0 36C0 16 14 6 30 0 14 6 0 16 0 36Z" opacity=".5"/>
        <circle cx="30" cy="36" r="7"/>
        <circle cx="0" cy="36" r="3.2"/>
        <circle cx="60" cy="36" r="3.2"/>
      </pattern>
    </defs>
    <rect x="-10" y="20" width="250" height="384" fill="url(#jaali)" opacity=".62"/>
    <path d="M18 20v384M112 20v384M206 20v384" opacity=".35"/>
    <path d="M-10 118h250M-10 262h250" opacity=".28"/>
  </svg>
)}

{side === 'right' && (
  <svg class="hero-art hero-art-right" viewBox="0 0 320 420" aria-hidden="true"
       focusable="false" xmlns="http://www.w3.org/2000/svg"
       fill="none" stroke="#c9a227" stroke-width="1.1">
    <defs>
      {/* one petal, revolved — a mandala drawn rather than stamped */}
      <g id="ring">
        <path id="pet" d="M0-128C26-92 26-64 0-40-26-64-26-92 0-128Z"/>
        <use href="#pet" transform="rotate(22.5)"/><use href="#pet" transform="rotate(45)"/>
        <use href="#pet" transform="rotate(67.5)"/><use href="#pet" transform="rotate(90)"/>
        <use href="#pet" transform="rotate(112.5)"/><use href="#pet" transform="rotate(135)"/>
        <use href="#pet" transform="rotate(157.5)"/><use href="#pet" transform="rotate(180)"/>
        <use href="#pet" transform="rotate(202.5)"/><use href="#pet" transform="rotate(225)"/>
        <use href="#pet" transform="rotate(247.5)"/><use href="#pet" transform="rotate(270)"/>
        <use href="#pet" transform="rotate(292.5)"/><use href="#pet" transform="rotate(315)"/>
        <use href="#pet" transform="rotate(337.5)"/>
      </g>
    </defs>

    {/* ogee arch, the temple doorway, kept as an outline */}
    <path d="M160 44c0 34 26 52 48 68 26 19 40 42 40 78v190H72V190c0-36 14-59 40-78 22-16 48-34 48-68Z"
          opacity=".75"/>
    <path d="M160 92c0 24 18 37 34 48 18 13 27 29 27 54v186H99V194c0-25 9-41 27-54 16-11 34-24 34-48Z"
          opacity=".5"/>
    <path d="M160 300a30 30 0 0 1 30 30v50h-60v-50a30 30 0 0 1 30-30Z" opacity=".6"/>

    <g transform="translate(232 148)" opacity=".8">
      <use href="#ring"/>
      <use href="#ring" transform="rotate(11.25) scale(.72)" opacity=".8"/>
      <circle r="34"/>
      <circle r="20" opacity=".7"/>
      <circle r="7" fill="#c9a227" stroke="none" opacity=".85"/>
    </g>

    <path d="M0 404h320" opacity=".5"/>
  </svg>
)}
