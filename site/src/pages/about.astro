---
import '../styles/tokens.css';
import data from '../data/events.json';
import Subscribe from '../components/Subscribe.astro';
import Disclaimer from '../components/Disclaimer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const feedHttps = new URL(`${base}/calendar.ics`, Astro.site ?? 'https://shalaka-kulkarni.github.io').href;
const feedWebcal = feedHttps.replace(/^https?:/, 'webcal:');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>About — Rasa Calendar</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <Disclaimer variant="short" />

    <header class="masthead">
      <div class="wrap">
        <p class="back"><a href={`${base}/`}>← Back to the calendar</a></p>
        <h1>About</h1>
      </div>
    </header>

    <main class="wrap">
      <p class="lede">
        Indian performing arts in New York are listed in two places that never
        overlap. Community listings carry the festivals, the garba nights and
        the recitals. The big presenters book world-class Indian artists and
        file them under "dance" or "world music." Neither knows about the
        other. Dozens of events a year, dozens of venues, no single list.
      </p>
      <p class="lede"><strong>This is the single list.</strong></p>

      <h2>What's here</h2>
      <p>
        Indian dance and music across the New York City metro area — classical
        forms (Bharatanatyam, Kathak, Odissi, Kuchipudi and the rest; Hindustani
        and Carnatic concerts), semi-classical and fusion, folk, contemporary,
        and film and popular repertoire. Performances, festivals, talks and
        workshops, plus community nights like garba and Diwali programmes.
        Five boroughs, New Jersey, Long Island, Westchester.
      </p>

      <h2>How it stays current</h2>
      <p>
        Automated sweeps read {data.sourceCount} venue calendars and listings
        three times a week, plus a weekly search for events beyond them. Every
        event is link-checked before it appears and re-checked afterwards.
        Nothing is listed on a maybe. Past events move to <strong>Past events</strong> automatically and stay
        for six months.
        The venue's own page is always the authority on dates, prices and tickets.
      </p>

      <h2>Get it by email</h2>
      <p>
        One email a month listing every event added to the calendar since the
        last one. Nothing else, and you can unsubscribe from any of them.
      </p>
      <Subscribe variant="about" />

      <h2>Or add it to your calendar app</h2>
      <p>Put every listed event straight into the calendar you already use.</p>
      <p class="cta-row">
        <a class="btn-poster btn-sub" href={feedWebcal}>＋ Subscribe — auto-updates</a>
      </p>
      <ul class="how">
        <li>
          <strong>Apple Calendar / Outlook</strong> — the button above subscribes
          directly. New events appear as they are added.
        </li>
        <li>
          <strong>Google Calendar</strong> — Other calendars → <em>From URL</em>,
          then paste: <code>{feedHttps}</code>
        </li>
        <li>
          <strong>One-off import</strong> — <a href={`${base}/calendar.ics`}>download the .ics file</a>.
          This is a snapshot: it will not update later.
        </li>
      </ul>
      <Disclaimer variant="long" />
    </main>

    <footer>
      <div class="wrap"><p><a href={`${base}/`}>← Back to the calendar</a></p></div>
    </footer>

    <style is:global>
      .masthead {
        background: #15110f; border-bottom: 6px solid var(--turmeric);
        padding: clamp(1.5rem, 4vw, 2.5rem) 0 clamp(1.2rem, 3vw, 2rem);
      }
      .masthead h1 {
        margin: .4rem 0 0; color: #fff9ec;
        font: 900 clamp(2rem, 6vw, 3.4rem)/0.92 var(--font-display);
        text-transform: uppercase; letter-spacing: -.01em;
        text-shadow: 4px 4px 0 #c4162a;
      }
      .back a, footer a {
        color: var(--turmeric); font: 700 .78rem/1 var(--font-condensed);
        letter-spacing: .12em; text-transform: uppercase; text-decoration: none;
      }
      footer a { color: var(--link); }
      .back { margin: 0; }
      main { padding: 2rem 1.25rem 3rem; max-width: 46rem; }
      .lede { font-size: 1.08rem; line-height: 1.6; }
      h2 {
        font: 900 1.15rem/1 var(--font-display); text-transform: uppercase;
        letter-spacing: .04em; margin: 2rem 0 .6rem;
        border-left: 10px solid var(--turmeric); padding-left: .7rem;
      }
      .cta-row { margin: .8rem 0 1.2rem; }
      .btn-sub { background: var(--turmeric); color: var(--turmeric-ink); }
      .how { padding-left: 1.1rem; margin: 0; }
      .how li { margin-bottom: .7rem; }
      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .84rem;
        background: var(--surface-sunk); border: 2px solid var(--rule);
        padding: .1rem .35rem; word-break: break-all;
      }
      footer {
        border-top: 6px solid var(--rule); background: var(--surface-sunk);
        padding: 1.2rem 0 2.5rem;
      }
      .disclaimer-strip {
        margin: 0; background: var(--rail-bg); color: var(--rail-ink);
        text-align: center; padding: .45rem 1rem;
        font: 700 .7rem/1.4 var(--font-condensed);
        letter-spacing: .1em; text-transform: uppercase;
        border-bottom: 2px solid var(--turmeric);
      }
      .disclaimer-long { margin: 2.4rem 0 0; border-top: 3px solid var(--rule-soft); padding-top: 1.2rem; }
      .disclaimer-long h2 {
        font: 900 1.15rem/1 var(--font-display); text-transform: uppercase;
        letter-spacing: .04em; margin: 0 0 .6rem; border-left: 10px solid var(--turmeric);
        padding-left: .7rem;
      }
      .disclaimer-long p { font-size: .88rem; line-height: 1.6; color: var(--ink-muted); }
    </style>
  </body>
</html>
