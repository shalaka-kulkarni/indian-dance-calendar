---
// Standard independent-aggregator disclaimer. Short strip at the top of every
// page, full text in the footer and on the About page.
const { variant = 'short' } = Astro.props;
---
{variant === 'short' && (
  <p class="disclaimer-strip">
    Independent, non-commercial listing · no commissions, no paid placements ·
    always check the venue's own page
  </p>
)}

{variant === 'long' && (
  <div class="disclaimer-long">
    <h2>Disclaimer</h2>
    <p>
      This is a free, independent, non-commercial listing of Indian performing
      arts events in the New York City metro area, run as a personal project.
      It is not affiliated with, endorsed by or sponsored by any venue,
      presenter, festival, artist or ticket seller.
    </p>
    <p>
      No commissions, referral fees, advertising revenue or other incentives are
      received for anything listed here. Nothing is a paid placement, and no
      organiser can buy inclusion or position. A listing is not a recommendation,
      an endorsement or a review.
    </p>
    <p>
      Event details are gathered automatically from public sources and checked
      before publication, but they can still be incomplete, out of date or wrong
      — programmes change, dates move and events are cancelled. The venue's or
      organiser's own page is always the authority on dates, times, prices,
      availability and tickets; please confirm there before travelling or buying.
      Ticket purchases happen entirely on those third-party sites, under their
      terms.
    </p>
    <p>
      Event titles, descriptions and images referenced remain the property of
      their respective organisers. If you are an organiser and would like a
      listing corrected, added or removed, please get in touch and it will be
      handled promptly.
    </p>
  </div>
)}
