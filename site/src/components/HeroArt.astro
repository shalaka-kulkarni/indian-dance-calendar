---
// Gopuram tower flanked by two rangoli discs, deliberately cropped by the
// masthead so it reads as printed artwork rather than a placed illustration.
// Hex values are hardcoded: the hero keeps its poster colours in both themes.
---
<svg class="hero-art" viewBox="0 0 1200 420" preserveAspectRatio="xMidYMax slice"
     aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <clipPath id="gopuram-clip">
      <path d="M600 8 665 88 640 88 700 178 668 178 740 288 700 288 780 412 420 412 500 288 460 288 532 178 500 178 560 88 535 88Z"/>
    </clipPath>
    <g id="rangoli">
      <circle r="94" fill="#2947c4"/>
      <g fill="#f7ce1a">
        <path id="petal" d="M0-92C22-56 22-40 0-16-22-40-22-56 0-92Z"/>
        <use href="#petal" transform="rotate(30)"/>
        <use href="#petal" transform="rotate(60)"/>
        <use href="#petal" transform="rotate(90)"/>
        <use href="#petal" transform="rotate(120)"/>
        <use href="#petal" transform="rotate(150)"/>
        <use href="#petal" transform="rotate(180)"/>
        <use href="#petal" transform="rotate(210)"/>
        <use href="#petal" transform="rotate(240)"/>
        <use href="#petal" transform="rotate(270)"/>
        <use href="#petal" transform="rotate(300)"/>
        <use href="#petal" transform="rotate(330)"/>
      </g>
      <circle r="34" fill="#c4162a"/>
      <circle r="15" fill="#fff9ec"/>
    </g>
  </defs>

  <use href="#rangoli" transform="translate(120 300) scale(.62)"/>
  <use href="#rangoli" transform="translate(1085 285) scale(.55)"/>

  <path d="M600 8 665 88 640 88 700 178 668 178 740 288 700 288 780 412 420 412 500 288 460 288 532 178 500 178 560 88 535 88Z" fill="#c4162a"/>
  <g clip-path="url(#gopuram-clip)">
    <rect x="420" y="112" width="360" height="16" fill="#f7ce1a"/>
    <rect x="420" y="206" width="360" height="16" fill="#f7ce1a"/>
    <rect x="420" y="312" width="360" height="16" fill="#f7ce1a"/>
    <rect x="420" y="352" width="360" height="60" fill="#007c7a"/>
    <path d="M600 352a40 40 0 0 1 40 40v20h-80v-20a40 40 0 0 1 40-40Z" fill="#17130e"/>
  </g>
</svg>
