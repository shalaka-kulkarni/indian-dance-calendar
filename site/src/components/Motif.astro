---
// One ornament per dance form, cropped into the corner of each card's poster
// panel. Line art rather than filled silhouettes: at watermark scale a filled
// shape reads as a blob, an outline reads as ornament. Colour is never the only
// carrier of meaning — the form name is always printed beside it.
const { form = 'other', class: cls = '' } = Astro.props;

const shapes = {
  // tradition-level ornaments (dance) plus one for music
  classical: '<path d="M50 12 76 46H68v42H32V46h-8z"/><path d="M50 88V62a10 10 0 0 1 20 0v26"/><circle cx="50" cy="44" r="7"/>',
  semi_classical_fusion: '<circle cx="38" cy="50" r="26"/><circle cx="62" cy="50" r="26"/>',
  contemporary: '<path d="M22 22h56v56H22z"/><path d="M78 22 22 78"/>',
  popular_film: '<rect x="20" y="20" width="60" height="60"/><rect x="26" y="28" width="9" height="9"/><rect x="26" y="46" width="9" height="9"/><rect x="26" y="64" width="9" height="9"/><rect x="65" y="28" width="9" height="9"/><rect x="65" y="46" width="9" height="9"/><rect x="65" y="64" width="9" height="9"/>',
  // veena/sitar in outline: gourd, neck, tuning pegs
  music: '<circle cx="34" cy="66" r="22"/><circle cx="34" cy="66" r="8"/><path d="M48 52 82 18"/><path d="M74 14l12 12"/><path d="M68 20l12 12"/><circle cx="86" cy="12" r="5"/>',
  // temple gopuram arch
  bharatanatyam: '<path d="M50 12 76 46H68v42H32V46h-8z"/><path d="M50 88V62a10 10 0 0 1 20 0v26"/><circle cx="50" cy="44" r="7"/>',
  // ghungroo bells on a cord
  kathak: '<path d="M12 26c22 14 54 14 76 0"/><circle cx="26" cy="46" r="12"/><circle cx="52" cy="54" r="12"/><circle cx="76" cy="44" r="12"/><path d="M26 34v-3M52 42v-4M76 32v-3"/>',
  // peacock feather eye
  odissi: '<ellipse cx="50" cy="50" rx="27" ry="38"/><ellipse cx="50" cy="46" rx="15" ry="21"/><circle cx="50" cy="44" r="6"/><path d="M50 88v10"/>',
  // brass plate and flute
  kuchipudi: '<circle cx="42" cy="60" r="26"/><circle cx="42" cy="60" r="14"/><path d="M18 24 88 44"/><circle cx="40" cy="30" r="3"/><circle cx="56" cy="35" r="3"/><circle cx="72" cy="39" r="3"/>',
  // oil lamp
  mohiniyattam: '<path d="M50 14c7 10 11 15 11 21a11 11 0 0 1-22 0c0-6 4-11 11-21z"/><path d="M26 54h48l-9 12H35z"/><path d="M40 66h20v12H40z"/><path d="M20 84h60"/>',
  // lotus
  manipuri: '<path d="M50 22c10 14 10 26 0 38-10-12-10-24 0-38z"/><path d="M50 60c14-10 26-10 36 0-10 10-22 10-36 0z"/><path d="M50 60c-14-10-26-10-36 0 10 10 22 10 36 0z"/><path d="M50 60c8 12 8 22 0 32-8-10-8-20 0-32z"/>',
  // khol drum
  sattriya: '<path d="M30 30h40c6 12 6 28 0 40H30c-6-12-6-28 0-40z"/><ellipse cx="30" cy="50" rx="7" ry="20"/><ellipse cx="70" cy="50" rx="7" ry="20"/><path d="M34 42h32M34 58h32"/>',
  // kathakali headdress frame
  kathakali: '<path d="M50 14c21 0 32 15 32 33S68 88 50 88 18 65 18 47 29 14 50 14z"/><path d="M34 44c5-7 12-7 16 0M50 44c5-7 12-7 16 0"/><path d="M36 66c8 7 20 7 28 0"/>',
  // dandiya sticks
  folk: '<path d="M20 76 76 20"/><path d="M24 20 80 76"/><circle cx="18" cy="78" r="6"/><circle cx="78" cy="18" r="6"/><circle cx="22" cy="18" r="6"/><circle cx="82" cy="78" r="6"/>',
  // film strip
  bollywood: '<rect x="20" y="20" width="60" height="60"/><rect x="26" y="28" width="9" height="9"/><rect x="26" y="46" width="9" height="9"/><rect x="26" y="64" width="9" height="9"/><rect x="65" y="28" width="9" height="9"/><rect x="65" y="46" width="9" height="9"/><rect x="65" y="64" width="9" height="9"/>',
  // two interlocking arcs
  fusion: '<circle cx="38" cy="50" r="26"/><circle cx="62" cy="50" r="26"/>',
  // open square
  contemporary_indian: '<path d="M22 22h56v56H22z"/><path d="M78 22 22 78"/>',
  // eight-point star
  other: '<path d="M50 12 62 38l26-12-12 26 12 26-26-12-12 26-12-26-26 12 12-26-12-26 26 12z"/>',
};
const d = shapes[form] || shapes.other;
---
<svg class={`motif ${cls}`} viewBox="0 0 100 100" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="5"
     stroke-linecap="round" stroke-linejoin="round"
     xmlns="http://www.w3.org/2000/svg" set:html={d}></svg>
