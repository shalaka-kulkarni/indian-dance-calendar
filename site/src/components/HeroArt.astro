---
// Masthead artwork, deliberately split to the LEFT and RIGHT edges so the
// title sits on clean ground between them rather than on top of the art.
// Hex values are hardcoded: the masthead keeps its poster colours in both themes.
const { side = 'left' } = Astro.props;
---
{side === 'left' && (
  <svg class="hero-art hero-art-left" viewBox="0 0 260 420" aria-hidden="true"
       focusable="false" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <g id="rangoli-l">
        <circle r="94" fill="#2947c4"/>
        <g fill="#f7ce1a">
          <path id="petal-l" d="M0-92C22-56 22-40 0-16-22-40-22-56 0-92Z"/>
          <use href="#petal-l" transform="rotate(30)"/><use href="#petal-l" transform="rotate(60)"/>
          <use href="#petal-l" transform="rotate(90)"/><use href="#petal-l" transform="rotate(120)"/>
          <use href="#petal-l" transform="rotate(150)"/><use href="#petal-l" transform="rotate(180)"/>
          <use href="#petal-l" transform="rotate(210)"/><use href="#petal-l" transform="rotate(240)"/>
          <use href="#petal-l" transform="rotate(270)"/><use href="#petal-l" transform="rotate(300)"/>
          <use href="#petal-l" transform="rotate(330)"/>
        </g>
        <circle r="34" fill="#c4162a"/>
        <circle r="15" fill="#fff9ec"/>
      </g>
    </defs>
    <use href="#rangoli-l" transform="translate(40 128) scale(.92)"/>
    <use href="#rangoli-l" transform="translate(150 320) scale(.58)"/>
    <rect x="0" y="404" width="260" height="16" fill="#007c7a"/>
  </svg>
)}

{side === 'right' && (
  <svg class="hero-art hero-art-right" viewBox="0 0 300 420" aria-hidden="true"
       focusable="false" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <clipPath id="gopuram-clip">
        <path d="M150 30 205 100 183 100 233 178 205 178 268 280 233 280 300 404 0 404 67 280 32 280 95 178 67 178 117 100 95 100Z"/>
      </clipPath>
      <g id="rangoli-r">
        <circle r="94" fill="#2947c4"/>
        <g fill="#f7ce1a">
          <path id="petal-r" d="M0-92C22-56 22-40 0-16-22-40-22-56 0-92Z"/>
          <use href="#petal-r" transform="rotate(30)"/><use href="#petal-r" transform="rotate(60)"/>
          <use href="#petal-r" transform="rotate(90)"/><use href="#petal-r" transform="rotate(120)"/>
          <use href="#petal-r" transform="rotate(150)"/><use href="#petal-r" transform="rotate(180)"/>
          <use href="#petal-r" transform="rotate(210)"/><use href="#petal-r" transform="rotate(240)"/>
          <use href="#petal-r" transform="rotate(270)"/><use href="#petal-r" transform="rotate(300)"/>
          <use href="#petal-r" transform="rotate(330)"/>
        </g>
        <circle r="34" fill="#c4162a"/>
        <circle r="15" fill="#fff9ec"/>
      </g>
    </defs>
    <path d="M150 30 205 100 183 100 233 178 205 178 268 280 233 280 300 404 0 404 67 280 32 280 95 178 67 178 117 100 95 100Z" fill="#c4162a"/>
    <g clip-path="url(#gopuram-clip)">
      <rect x="0" y="120" width="300" height="15" fill="#f7ce1a"/>
      <rect x="0" y="205" width="300" height="15" fill="#f7ce1a"/>
      <rect x="0" y="300" width="300" height="15" fill="#f7ce1a"/>
      <rect x="0" y="344" width="300" height="60" fill="#007c7a"/>
      <path d="M150 344a38 38 0 0 1 38 38v22h-76v-22a38 38 0 0 1 38-38Z" fill="#15110f"/>
    </g>
    <use href="#rangoli-r" transform="translate(272 96) scale(.62)"/>
    <rect x="0" y="404" width="300" height="16" fill="#007c7a"/>
  </svg>
)}
